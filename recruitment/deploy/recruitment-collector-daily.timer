[Unit]
Description=Run medical recruitment daily digest with bounded morning retry opportunities

[Timer]
OnCalendar=*-*-* 07:30:00 Asia/Shanghai
OnCalendar=*-*-* 08:00:00 Asia/Shanghai
OnCalendar=*-*-* 08:30:00 Asia/Shanghai
Persistent=true
AccuracySec=30s
RandomizedDelaySec=0
Unit=recruitment-collector-daily.service

[Install]
WantedBy=timers.target
