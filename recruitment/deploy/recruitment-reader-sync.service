[Unit]
Description=Medical recruitment public report sync receiver
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=recruitment-reader
Group=recruitment-reader
WorkingDirectory=/opt/recruitment-reader
EnvironmentFile=/etc/recruitment-reader/sync.env
Environment=NODE_ENV=production
ExecStart=/opt/recruitment-reader/runtime/node/bin/node /opt/recruitment-reader/recruitment/site-server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/recruitment-reader
MemoryHigh=192M
MemoryMax=256M
CPUQuota=50%
TasksMax=32
LimitNOFILE=1024
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
